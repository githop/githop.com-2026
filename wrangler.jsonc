{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githop",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "assets": {
    // Everything else (/, CSS, JS chunks) is served straight from the asset
    // edge cache without invoking the Worker.
    "run_worker_first": ["/resume"]
  }
}
