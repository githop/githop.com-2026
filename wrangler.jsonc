{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githop",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "workers_dev": false,
  "routes": [
    { "pattern": "githop.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    // Everything else (/, CSS, JS chunks) is served straight from the asset
    // edge cache without invoking the Worker.
    "run_worker_first": ["/resume"]
  }
}
